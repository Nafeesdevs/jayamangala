PORT=4000
DB_URL=mongodb://localhost:27017/ecommercedb
NODE_ENV=development

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRE=7d
EXPIRE_COOKIE=7

# Cloudinary (https://cloudinary.com -> Dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Seed users (created automatically on first start)
ADMIN_NAME=Super Admin
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=Admin@123
ADMIN_EMAIL=admin@example.com

DEMO_NAME=Demo User
DEMO_PHONE=8888888888
DEMO_PASSWORD=Demo@123
DEMO_EMAIL=demo@example.com

# Payment (QR / barcode). Put your QR image url (upload it to Cloudinary) and UPI id
PAYMENT_QR_IMAGE_URL=https://res.cloudinary.com/your_cloud_name/image/upload/payment-qr.png
PAYMENT_UPI_ID=yourshop@upi
PAYMENT_PAYEE_NAME=Your Shop Name

# Order
DELIVERY_CHARGE=50
