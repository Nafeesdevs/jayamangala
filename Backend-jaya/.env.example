PORT=
DB_URL=
NODE_ENV=development

JWT_SECRET=
JWT_EXPIRE=7d
EXPIRE_COOKIE=7

# CORS — comma-separated list of allowed frontend origins in production
# Example: https://jayamangala-s12t.vercel.app,https://yourdomain.com
ALLOWED_ORIGINS=https://jayamangala-s12t.vercel.app

# Cloudinary (https://cloudinary.com -> Dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Seed users (created automatically on first start)
ADMIN_NAME=Super Admin
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=Admin@1
ADMIN_EMAIL=admin@exampl.com

DEMO_NAME=Demo User
DEMO_PHONE=8888888888
DEMO_PASSWORD=Demo@
DEMO_EMAIL=demo@example.com

# Payment (QR / barcode). Put your QR image url (upload it to Cloudinary) and UPI id
PAYMENT_QR_IMAGE_URL=
PAYMENT_UPI_ID=yourshop@upi
PAYMENT_PAYEE_NAME=Your Shop Name

# Order
DELIVERY_CHARGE=50
