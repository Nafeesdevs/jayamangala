# Backend API (the backend folder runs on PORT 4000 by default)
VITE_API_URL=http://localhost:4000/api/v1
# Shown on the login page as quick-fill buttons. Set to false in production.
VITE_SHOW_DEMO=true
VITE_DEMO_ADMIN_PHONE=9999999999
VITE_DEMO_ADMIN_PASSWORD=Admin@123
VITE_DEMO_USER_PHONE=8888888888
VITE_DEMO_USER_PASSWORD=Demo@123
# Used only if the backend does not send deliveryCharge (must match backend DELIVERY_CHARGE)
VITE_DELIVERY_CHARGE=50
